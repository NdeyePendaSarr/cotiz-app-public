# Deux fichiers, jamais committés (.env* est ignoré par Git) :
#   .env       → DÉVELOPPEMENT : Supabase en local (npm run supabase:start). Lu par
#                `npm run dev`, Prisma (migrations, seed, studio).
#   .env.prod  → PRODUCTION : projet Supabase cloud. Lu UNIQUEMENT de façon explicite
#                (npm run db:migrate:prod). Next ne le charge jamais tout seul.
# Mêmes noms de variables dans les deux. Ci-dessous : les valeurs du .env LOCAL.
# Elles sont identiques sur toutes les installations Supabase locales (pas secrètes) ;
# `npx supabase status` les affiche.

# Base locale (Supabase local, port 54322). En production (Vercel compris) : pooler en mode
# TRANSACTION, port 6543, avec ?pgbouncer=true. Jamais le mode session (port 5432 du pooler) :
# limité à 15 clients, il sature dès deux pages ouvertes (erreur EMAXCONNSESSION).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# Connexion directe pour les migrations. En production : port 5432.
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# API Supabase (Auth). Clé publique : envoyée au navigateur, donc jamais un secret.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable key de `npx supabase status`>"

# Numéro Wave de la trésorière, cité dans les messages de relance par défaut
# (« Tu peux l'envoyer par Wave au … »). Facultatif : sans lui, la phrase est retirée.
# NEXT_PUBLIC_ : le message est construit dans le navigateur. Pas un secret (les membres le reçoivent),
# mais il reste hors du dépôt. Lu au build : après un changement sur Vercel, redéployer.
NEXT_PUBLIC_NUMERO_WAVE_RELANCE=""

# ── Sauvegardes (dans .env.prod, voir le README) ─────────────────────────────
# npm run db:sauvegarde écrit dans ce dossier, jamais dans le dépôt (par défaut : ~/cotiz-sauvegardes).
# SAUVEGARDE_DOSSIER="C:\Users\...\cotiz-sauvegardes"
# Copie sur une clé USB ou un disque externe chiffré : sans elle, la commande affiche un avertissement.
# SAUVEGARDE_COPIE="E:\cotiz-sauvegardes"

# ── Local uniquement : seed de démo (jamais dans .env.prod) ──────────────────
# Clé d'administration du Supabase LOCAL (« secret key » de `npx supabase status`).
SUPABASE_SERVICE_ROLE_KEY="<secret key de `npx supabase status`>"
# Compte de démo créé par le seed s'il n'existe pas.
SEED_UTILISATRICE_EMAIL="demo@cotiz.test"
SEED_UTILISATRICE_MOT_DE_PASSE="<au moins 8 caractères>"
