  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:isolation": "vitest run --config vitest.integration.config.ts",
    "postinstall": "prisma generate",
